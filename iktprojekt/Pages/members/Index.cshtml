@page
@model iktprojekt.Pages.MemberPages.IndexModel

@{
    ViewData["Title"] = "Tagok";
}

<h1>Tagok</h1>

<p>
    <a asp-page="Create">Új hozzáadása</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Member[0].Tasks)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Member) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Tasks)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerkesztés</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Részletek</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
