@page "/project/{projectid:int}/details"
@model iktprojekt.Pages.ProjectPages.DetailsModel
@using iktprojekt.Models;

@{
    ViewData["Title"] = "Részletek";
}

<h1 class="text-center">@Model.Project.Name<br /> <span class="text-md">@Model.Project.Description</span></h1>
<div style="height: 30px; width: 200px; border: 1px solid gray; margin-inline: auto; margin-top: 10px; position: relative;" class="mb-10">
    <div style="width: @(Model.completionRate)%; background-color: greenyellow; height: 100%"></div>
    <p style="position: absolute; left: 50%; top: 3px; transform: translateX(-50%)">@Model.completionRate%</p>
</div>

<div class="flex justify-between">
        <h2 class="mb-10">Teendők</h2>
    <div class="flex gap-2">
        <div class="flex items-center">
            <button id="filter-submit"
            onclick="location.replace('?memberid=' + document.getElementById('member-filter').value)"
            >Szűrés</button>
            <select id="member-filter" asp-items="@Model.activeMembers" class="member-select">
                <option value="">Nincs kiválasztott beosztott</option>
            </select>
        </div>
        <a href="/project/@Model.Project.Id/createtodo">+ Teendő</a>
        <a asp-page="./Edit" asp-route-id="@Model.Project.Id">Projekt szerkesztése</a>
    </div>
</div>

<div class="flex">
    <div class="flex flex-col todo-col">
            @foreach(var todo in Model.TodoTasks)
            {
                <div class="todo flex flex-col @(@todo.Priority == PTask.TodoPriority.High ? "prio-high" : (@todo.Priority == PTask.TodoPriority.Medium ? "prio-medium" : "") )">
                    <p class="text-md bold flex"><span>@todo.Title</span><button onclick="fetch('/todo/progressstate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ todoId: @todo.Id })
    }).then(() => location.reload())">-></button></p>
                    <p class="text-sm">@Html.DisplayFor(model => @todo.State)</p>
                    <p class="text-sm">@(todo.Deadline?.ToString("yyyy.MM.dd HH:mm") ?? "(nincs határidő)")</p>
                    <p class="text-sm">@(todo.Member?.Name ?? "(nincs beosztott)")</p>
                    <p class="text-sm">Fontosság: @Html.DisplayFor(model => @todo.Priority)</p>
                    <a class="text-sm" href="/edit/@todo.Id">Szerkesztés</a>
                </div>
            }
        </div>

    <div class="flex flex-col todo-col">
        @foreach(var todo in Model.InProgressTasks)
            {
                <div class="todo inprogress flex flex-col @(@todo.Priority == PTask.TodoPriority.High ? "prio-high" : (@todo.Priority == PTask.TodoPriority.Medium ? "prio-medium" : "") )">
                    <p class="text-md bold flex"><span>@todo.Title</span><button  onclick="fetch('/todo/progressstate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ todoId: @todo.Id })
    }).then(() => location.reload())">-></button></p>
                    <p class="text-sm">@Html.DisplayFor(model => @todo.State)</p>
                    <p class="text-sm">@(todo.Deadline?.ToString("yyyy.MM.dd HH:mm") ?? "(nincs határidő)")</p>
                    <p class="text-sm">@(todo.Member?.Name ?? "(nincs beosztott)")</p>
                    <p class="text-sm">Fontosság: @Html.DisplayFor(model => @todo.Priority)</p>
                    <a class="text-sm" href="/edit/@todo.Id">Szerkesztés</a>
                </div>
            }
    </div>

    <div class="flex flex-col todo-col">
        @foreach(var todo in Model.CompletedTasks)
            {
                <div class="todo completed flex flex-col @(@todo.Priority == PTask.TodoPriority.High ? "prio-high" : (@todo.Priority == PTask.TodoPriority.Medium ? "prio-medium" : "") )">
                    <p class="text-md bold">@todo.Title</p>
                    <p class="text-sm">@Html.DisplayFor(model => @todo.State)</p>
                    <p class="text-sm">@(todo.Deadline?.ToString("yyyy.MM.dd HH:mm") ?? "(nincs határidő)")</p>
                    <p class="text-sm">@(todo.Member?.Name ?? "(nincs beosztott)")</p>
                    <p class="text-sm">Fontosság: @Html.DisplayFor(model => @todo.Priority)</p>
                    <a class="text-sm" href="/edit/@todo.Id">Szerkesztés</a>
                </div>
            }
    </div>
</div>
