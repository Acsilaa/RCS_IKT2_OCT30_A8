@page "/details/{todoid:int}"
@model iktprojekt.Pages.PTaskPages.DetailsModel

@{
    ViewData["Title"] = "Részletek";
}

<h1>Részletek</h1>

<div>
    <h4>Teendő</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.State)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.State)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.Priority)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.Priority)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.Deadline)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.Deadline)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.MemberId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.MemberId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.ProjectId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.ProjectId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.Member)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.Member)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PTask.Project)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PTask.Project)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.PTask.Id">Szerkesztés</a> |
    <a asp-page="./Index">Vissza</a>
</div>
