@page
@using iktprojekt.Models
@model iktprojekt.Pages.PTaskPages.CreateModel

@{
    ViewData["Title"] = "Új elem";
}

<h1>Új elem</h1>

<h4>Teendő</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.Title" class="control-label"></label>
                <input asp-for="PTask.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="PTask.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.State" class="control-label"></label>
                <select asp-items="Html.GetEnumSelectList<PTask.TodoState>()" asp-for="PTask.State"></select>
                <span asp-validation-for="PTask.State" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Priority" class="control-label"></label>
                <select asp-for="PTask.Priority" asp-items="Html.GetEnumSelectList<PTask.TodoPriority>()">
                </select>
                <span asp-validation-for="PTask.Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Deadline" class="control-label"></label>
                <input asp-for="PTask.Deadline" class="form-control" type="datetime-local" id="deadlineSelect" />
                <span asp-validation-for="PTask.Deadline" class="text-danger" id="deadlineHelp"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.MemberId" class="control-label"></label>
                <select asp-for="PTask.MemberId" asp-items="Model.Members" class="form-control">
                    <option value="">-- Válasszon Tagot --</option>
                </select>
                <span asp-validation-for="PTask.MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.ProjectId" class="control-label"></label>
                <select asp-for="PTask.ProjectId" class="form-control" id="projectSelect">
                     <option value="">-- Válasszon projektet --</option>
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id" data-deadline="@(project.Deadline?.ToString("yyyy-MM-ddTHH:mm") ?? "")">@project.Name</option>
                    }
                </select>
                <span asp-validation-for="PTask.ProjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Létrehozás" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Vissza</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @{
        <script src="~/js/create-task.js"></script>
    }
}
