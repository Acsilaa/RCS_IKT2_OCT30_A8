@page
@model iktprojekt.Pages.PTaskPages.EditModel

@{
    ViewData["Title"] = "Szerkesztés";
}

<h1>Szerkesztés</h1>

<h4>PTask</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PTask.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.Title" class="control-label"></label>
                <input asp-for="PTask.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="PTask.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.State" class="control-label"></label>
                <input asp-for="PTask.State" class="form-control" aria-required="true"/>
                <span asp-validation-for="PTask.State" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Priority" class="control-label"></label>
                <input asp-for="PTask.Priority" class="form-control" />
                <span asp-validation-for="PTask.Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Deadline" class="control-label"></label>
                <input asp-for="PTask.Deadline" class="form-control" />
                <span asp-validation-for="PTask.Deadline" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.MemberId" class="control-label"></label>
                <input asp-for="PTask.MemberId" class="form-control" />
                <span asp-validation-for="PTask.MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.ProjectId" class="control-label"></label>
                <input asp-for="PTask.ProjectId" class="form-control" aria-required="true"/>
                <span asp-validation-for="PTask.ProjectId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Member" class="control-label"></label>
                <input asp-for="PTask.Member" class="form-control" />
                <span asp-validation-for="PTask.Member" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Project" class="control-label"></label>
                <input asp-for="PTask.Project" class="form-control" />
                <span asp-validation-for="PTask.Project" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Vissza</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
