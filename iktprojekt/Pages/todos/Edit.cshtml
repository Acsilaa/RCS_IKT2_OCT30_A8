@page "/edit/{todoid:int}"
@model iktprojekt.Pages.PTaskPages.EditModel
@using iktprojekt.Models

@{
    ViewData["Title"] = "Szerkesztés";
}

<h1>Szerkesztés</h1>

<h4>PTask</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PTask.ProjectId" value="@Model.ProjectId" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="PTask.Title" class="control-label"></label>
                <input asp-for="PTask.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="PTask.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Priority" class="control-label"></label>
                <select asp-for="PTask.Priority" class="form-control" asp-items="Html.GetEnumSelectList<PTask.TodoPriority>()"></select>
                <span asp-validation-for="PTask.Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.Deadline" class="control-label"></label>
                <input asp-for="PTask.Deadline" class="form-control" type="datetime-local" max="@Model.Project.Deadline?.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="PTask.Deadline" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PTask.MemberId" class="control-label"></label>
                <select asp-for="PTask.MemberId" asp-items="Model.Members" class="form-control">
                    <option value="">-- Válasszon Tagot --</option>
                </select>
                <span asp-validation-for="PTask.MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/project/@Model.Project.Id/details">Haza</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
